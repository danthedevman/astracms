<%-include('../partials/container_start.ejs')%>
<%if(typeof assets !== "undefined"){%>
<div class="row mb-2">
  <%assets.forEach((asset)=>{%>
  <div class="col-6 mb-3">
    <div class="card">
      <div class="card-header">
        <div class="card-title" style="font-size:16px;">
          <div><%=asset.name%></div>
        </div>
      </div>
      <div class="card-body" style="height:300px;overflow: hidden;">
        <div class="d-flex align-items-center flex-column justify-content-center" style="height:100%;">
          <%if(asset.mimetype.indexOf("image") !== -1){%>
          <img style="width:100%;height:100%;object-fit: contain;" class="img-responsive" src="<%=locals.BUCKET_PUBLIC_HOST_URL+'/'+base._id+'__'+asset.name%>" />
          <%}%>
            <%if(asset.mimetype.indexOf("video") !== -1){%>
          <video width="100%" height="100%" controls>
            <source src="<%=locals.BUCKET_PUBLIC_HOST_URL+'/'+base._id+'__'+asset.name%>" type="<%=asset.mimetype%>">
            Your browser does not support the video tag.
          </video>
          <%}%>
        </div>
     </div>
     <div class="card-footer">
        <div class="d-flex align-items-center justify-content-between">
            <button data-asset_id="<%=asset._id.toString()%>" data-action="delete_asset" class="btn btn-outline-danger btn-sm">
          Delete
          </button>
        </div>
      </div>
    </div>
  </div>
  <%})%>
</div>
<%}%>
<%-include('../partials/container_end.ejs')%>

<script>
  (() => {
    const deleteAssetBtns = document.querySelectorAll('[data-action="delete_asset"]');
    deleteAssetBtns.forEach((btn) => {
      btn.onclick = async (evt) => {
        evt.preventDefault();
        let asset_id = btn.getAttribute("data-asset_id");
        let res = await fetch(`/${window._astracms.base_id}/assets/${asset_id}/delete`, {
          method: "DELETE",
          credentials: "same-origin",
          headers: {
            "Content-Type": "application/json",
          },
        });

        if (res.status === 200) {
            if (Turbo) {
              Turbo.visit(`${document.location.pathname}${document.location.search}`);
            }
          }
      }
    })
  })()
</script>