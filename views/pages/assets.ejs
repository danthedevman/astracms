<%if(typeof assets !== "undefined" && assets.length > 0){%>
<%-include('../partials/container_start.ejs')%>
<div class="row mb-2">
  <%assets.forEach((asset)=>{%>
  <div class="col-12 col-md-6 col-lg-4 mb-3">
    <div data-asset class="card">
      <div class="card-header">
        <div data-bs-toggle="tooltip" title="<%=asset.name%>" class="card-title" style="font-size:16px;">
          <div class="text-truncate"><%=asset.name%></div>
        </div>
      </div>
      <div class="card-body" style="height:200px;overflow: hidden;">
        <div data-asset_previews class="d-flex align-items-center flex-column justify-content-center" style="height:100%;">
          <%if(asset.mimetype.indexOf("image") !== -1){%>
          <img height="200px" width="200px" style="max-width:200px;height:100%;object-fit: contain;" class="img-responsive" src="<%=locals.BUCKET_PUBLIC_HOST_URL+'/'+base._id+asset.asset_id%>?t=<%=asset._updated_on%>" />
          <%}%>
            <%if(asset.mimetype.indexOf("video") !== -1){%>
          <video width="100%" height="100%" controls>
            <source src="<%=locals.BUCKET_PUBLIC_HOST_URL+'/'+base._id+asset.asset_id%>" type="<%=asset.mimetype%>">
            Your browser does not support the video tag.
          </video>
          <%}%>
          <%if(asset.mimetype.indexOf("html") !== -1){%>
           <i class="bi bi-file"></i>
            <%}%>
        </div>
     </div>
     <div class="card-footer">
        <div class="d-flex align-items-center justify-content-between">
            <button data-asset_name="<%=asset.name.toString()%>" data-asset_id="<%=asset._id.toString()%>" data-action="delete_asset" class="btn btn-danger btn-sm">
          <i class="bi bi-trash"></i>
          </button>
         <div data-asset_actions class="d-flex align-items-center">
          <button data-asset_name="<%=asset.name.toString()%>" data-asset_id="<%=asset._id.toString()%>" data-action="copy_asset_link" class="btn btn-secondary btn-sm me-2">
            <i class="bi bi-link"></i>
          </button>
          <button data-asset_name="<%=asset.name.toString()%>" data-asset_id="<%=asset.asset_id.toString()%>" data-action="edit_asset_file" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil"></i>
          </button>
          <input type="file" style="display:none !important;" name="edit_asset_file_input"/>
         </div>
        </div>
      </div>
    </div>
  </div>
  <%})%>
</div>
<%-include('../partials/container_end.ejs')%>
<%}else{%>
<div class="empty_state_wrapper">
  <div></div>
  <div>No assets found</div>
</div>
<%}%>

<script>
  (() => {

    const editAssetFileBtns = document.querySelectorAll(`[data-action="edit_asset_file"]`);
    editAssetFileBtns.forEach((btn)=>{
      btn.onclick = (evt)=>{
        evt.preventDefault();
        const actionWrapper = btn.closest(`[data-asset_actions]`);
        if(!actionWrapper){
          return;
        }

        let fileInput = actionWrapper.querySelector("[name='edit_asset_file_input']");
        if(fileInput){
          fileInput.click();
        }

        fileInput.onchange = (evt) => {
        let file = fileInput.files[0];

        if (!file) {
          return
        }
        btn.setAttribute("disabled",true);
        const formData = new FormData();
        formData.append("file", file);
        fetch(`/${window._astracms.base_id}/assets/upload${btn.getAttribute("data-asset_id") ? '/'+btn.getAttribute("data-asset_id") : ''}`, {
          method: "POST",
          body: formData,
        }).then((res) => {
          if (res.status === 200) {
           let mediaEle =  btn.closest(`[data-asset]`).querySelector(`[data-asset_previews]`).querySelector("[src]");
            if (Turbo) {
              Turbo.visit(`${document.location.pathname}${document.location.search}`);
            }
          }
          btn.removeAttribute("disabled");
        });
      };
      }
    });


    const deleteAssetBtns = document.querySelectorAll('[data-action="delete_asset"]');
    deleteAssetBtns.forEach((btn) => {
      btn.onclick = async (evt) => {
        evt.preventDefault();
        btn.setAttribute("disabled",true);
        const confirmDelete = confirm(`Are you sure you want to delete asset ${btn.getAttribute('data-asset_name')}?`);
        if(!confirmDelete){
            btn.removeAttribute("disabled");
            return;
        }
        let asset_id = btn.getAttribute("data-asset_id");
        let res = await fetch(`/${window._astracms.base_id}/assets/${asset_id}/delete`, {
          method: "DELETE",
          credentials: "same-origin",
          headers: {
            "Content-Type": "application/json",
          },
        });

        if (res.status === 200) {
            if (Turbo) {
              Turbo.visit(`${document.location.pathname}${document.location.search}`);
            }
          }

          btn.removeAttribute("disabled");
      }
    })
  })()
</script>