<%-include('../partials/container_start.ejs')%>
<%if(typeof assets !== "undefined"){%>
<div class="row mb-2">
    <%assets.forEach((asset)=>{%>
  <div class="col-12 mb-3">
    <div class="card">
        <div class="card-header">
            <div class="card-title">
                <div><%=asset.name%></div>
            </div>
        </div>
     <div class="card-body">
        <div class="d-flex align-items-center flex-column justify-content-center">
            <%if(asset.mimetype.indexOf("image") !== -1){%>
            <img style="width:100%;height:100%;"  class="img-responsive" src="<%=locals.BUCKET_PUBLIC_HOST_URL+'/'+base._id+'__'+asset.name%>"/>
            <%}%>
            <%if(asset.mimetype.indexOf("video") !== -1){%>
                <video width="100%" height="100%" controls>
                    <source src="<%=locals.BUCKET_PUBLIC_HOST_URL+'/'+base._id+'__'+asset.name%>" type="<%=asset.mimetype%>">
                  Your browser does not support the video tag.
                </video>
            <%}%>
        </div>
     </div>
     <div class="card-footer">

     </div>
    </div>
  </div>
  <%})%>
</div>
<%}%>
<%-include('../partials/container_end.ejs')%>