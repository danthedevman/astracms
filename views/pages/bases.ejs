<%-include('../partials/container_start.ejs')%>
<div class="row mb-3">
  <div class="col-12">
    <div class="d-flex align-items-center justify-content-between">
      <h1 class="m-0">Bases</h1>
      <button data-action="add_base" class="ms-2 btn btn-primary">
        <i class="bi bi-plus me-1"></i>Add Base
      </button>
    </div>
  </div>
</div>
<div class="row">
  <%if(typeof bases !== "undefined"){%>
  <%bases.forEach((base)=>{%>
  <div class="col-md-4">
    <a href="/<%=base._id%>/dashboard" class="card text-decoration-none">
      <div class="card-body">
        <%=base.name%>
      </div>
    </a>
  </div>
  <%})%>
  <%}%>
</div>
<%-include('../partials/container_end.ejs')%>

  <script type="module">
    import BaseUtil from "../scripts/bases/BaseUtil.js";
    (() => {
      const addBaseBtn = document.querySelector("[data-action='add_base']");
      addBaseBtn.onclick = (evt) => {
        evt.preventDefault();
        alert('Creating Base')
        new BaseUtil().createBase({
          name: "Base 1",
          description: "Lorem ipsum dolor sit amet consectetur adipisicing elit. Voluptatem atque quae, id consectetur quas facilis omnis architecto vitae quaerat at possimus voluptate quis amet illo deserunt quia animi tempora? Odio."
        });
      }
    })()
  </script>