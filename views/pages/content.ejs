<%-include('../partials/container_start.ejs')%>
<div class="row mb-3 d-none">
  <%-include('../partials/menus/content_pills.ejs')%>
</div>
<div class="row mb-3">
  <div class="col-md-3">
    <div class="dropdown_select_wrapper">
      <div class="dropdown w-100 ">
        <button class="btn btn-light border-secondary d-flex align-items-center justify-content-between w-100" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
          <div>All</div>
          <div><i class="bi bi-chevron-down"></i><i class="bi bi-chevron-up d-none"></i></div>
        </button>
        <ul style="width:100%;height:200px;overflow-y: auto;" class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
          <%models.forEach((model)=>{%>
            <li class="dropdown-item">
                <a class="d-block" href="/<%=locals.base._id%>/content/<%=model._id%>"><%=model.label%></a>
            </li>
        <%})%>
        </ul>
      </div>
    </div>
  </div>
</div>
<div class="row">
  <div class="col-12">
    <div class="card mb-3" style="height:calc(100vh - 80px - 24px - 100px);min-width: 800px; overflow-x:auto;">
      <div class="card-header">
        <div class="card-title">
          <div class="d-flex align-items-center justify-content-between" style="height:32px;">
            <div class="d-flex align-items-center">
              <div>All Content</div>
            </div>
            <div>
              <a class="d-none btn btn-primary">
                New Record
              </a>
            </div>
          </div>
        </div>
      </div>
      <div class="card-body">
        <%-include('../partials/tables/content_table.ejs')%>
      </div>
    </div>
  </div>
</div>

<%-include('../partials/container_end.ejs')%>