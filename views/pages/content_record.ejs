<%-include('../partials/container_start.ejs')%>
<div class="row">
  <div class="col-md-<%=typeof record !== "undefined" ? '8' : '12'%>">
    <div>
      <%-include('../partials/forms/content_form.ejs')%>
    </div>
  </div>
  <%if(typeof record !== "undefined"){%>
  <div class="col-md-4">
    <div class="mb-2">
      <div class="card content_record_info_card">
        <div class="card-header">
          <div class="card-title">
            Details
          </div>
        </div>
        <div class="card-body">
          <div class="mb-1">
            <label>Status:</label>
            <% 
            let statusMap = {
              draft:"Draft",
              unpublished:"Unpublished",
              published:"Published"
            };
            %>
            <div><%=record._status === "published" ? record._published_changes ? "Published" : "Draft (Unpublished Changes)" : statusMap[record._status] || "Draft"%></div>
            <div class="d-none">Draft (Unpublished)</div>
            <div class="d-none">Draft (Published)</div>
            <div class="d-none">Published</div>
            <div class="d-none">Archived</div>
          </div>
          <hr class="my-2" />
          <div class="mb-1">
            <label>API Id:</label>
            <div style="word-break:break-all;" class="bg-secondary rounded py-1 px-2 d-flex align-items-center justify-content-between">
                <span style="font-size: 14px !important;"><%=record._id%></span><span><i class="bi bi-clipboard"></i></span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="mb-2">
      <div class="card content_record_info_card">
        <div class="card-header">
          <div class="card-title">
            Meta
          </div>
        </div>
        <div class="card-body">
          <div class="mb-1">
            <label>Created On:</label>
            <div><%=record._created_on%></div>
          </div>
          <hr class="my-2" />
          <div class="mb-1">
            <label>Created by:</label>
            <div><%=record._created_by%></div>
          </div>
          <hr class="my-2" />
          <div class="mb-1">
            <label>Updated on:</label>
            <div><%=record._updated_on%></div>
          </div>
          <hr class="my-2" />
          <div class="mb-1">
            <label>Updated by:</label>
            <div><%=record._updated_by%></div>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%}%>
</div>
<%-include('../partials/container_end.ejs')%>