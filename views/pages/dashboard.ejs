<% 
var demo_data = {
  counts:[
    {
      label:"Total Content",
      count:100
    },
    {
      label:"Total Models",
      count:5
    },
    {
      label:"Total Assets",
      count:10
    },
    {
      label:"Total Users",
      count:1
    }
  ]
};
%>

<%-include('../partials/container_start.ejs')%>
<div class="row">
  <%demo_data.counts.forEach(card => {%>
    <div class="col-12 col-md-6 col-lg-3">
      <div class="dashboard_count_card mb-3">
        <div class="label">
          <%=card.label%>
        </div>
        <div class="count">
          <%=card.count%>
        </div>
      </div>
    </div>
  <%});%>
</div>
<%-include('../partials/container_end.ejs')%>