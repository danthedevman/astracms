<%if(typeof model !== "undefined"){%>

<% 
 const fieldDefinitions = [
  {
    label:"Label",
    name:"label"
  },
  {
    label:"Name",
    name:"name"
  },
  {
    label:"Type",
    name:"type",
    type:"choice",
    choices:{
        single_line_text:"Single Line Text",
        checkbox:"Checkbox",
        rich_text:"Rich Text",
        reference:"Reference",
        asset:"Asset",
        multi_line_text:"Mult Line Text",
        yes_no:"Yes/No",
        choice:"Choice"
    }
  },
  {
    label:"Title Field",
    name:"title_field",
    type:"choice",
    choices:{yes:"Yes",no:"No"}
  },
  {
    label:"Mandatory",
    name:"mandatory",
    type:"choice",
    choices:{yes:"Yes",no:"No"}
  },
  {
    label:"Hidden On Form",
    name:"hidden_on_form",
    type:"choice",
    choices:{yes:"Yes",no:"No"}
  },
  {
    label:"Reference Type",
    name:"reference_type",
    type:"choice",
    choices:{single:"Single Record",multiple:"Multiple Records"}
  },
  {
    label:"Select Reference",
    name:"reference_model",
    type:"reference",
  }
];
 %>
<%-include('../partials/container_start.ejs')%>
<div class="row mb-3">
  <div class="d-flex align-items-center justify-content-between">
    <div>
      <button data-bs-toggle="modal" data-bs-target="#save_field_modal" class="btn btn-primary shadow">
        <i class="bi bi-plus-circle me-2"></i>Add Field
      </button>
    </div>
    <div class="d-flex align-items-center d-none">
      <button class="btn text-white"><i class="bi bi-grid me-1"></i></button>
      <button class="btn text-white"><i class="bi bi-list"></i></button>
    </div>
  </div>
</div>
<%if(typeof fields !== "undefined"){%>
<%fields.forEach((field)=>{%>
<div class="row mb-3">
  <div class="col-12">
    <div class="card">
      <div class="card-header p-0 bg-transparent d-flex align-items-center">
        <div>
          <button class="btn text-white"><i class="bi bi-grip-vertical"></i></button>
        </div>
        <div data-bs-toggle="collapse" data-bs-target="#_<%=field._id%>" class="p-3 card-title d-flex align-items-center w-100">
          <%=field.label%><%if(field.title_field === "yes"){%><span class="ms-2 badge bg-secondary">Title Field</span><%}%>
          <span class="mx-2 badge bg-primary"><%=fieldDefinitions[2].choices[field.type]%></span>
        </div>
        <div class="p-3 ms-auto card_actions d-flex align-items-center">
          <button data-action="delete_field" data-field_data="<%=JSON.stringify(field)%>"
          data-field_id="<%=field._id%>" class="btn btn-danger">Delete</button>
          <button data-action="edit_field" data-field_data="<%=JSON.stringify(field)%>" class="ms-2 btn btn-primary">Edit</button>
        </div>
      </div>
      <div class="card-body collapse" id="_<%=field._id%>">
        <div class="row">
          <%fieldDefinitions.forEach((fd)=>{%>
          <%if(field.type === "reference"){%>
          <%if(fd.name !== "reference_model"){%>
          <div class="col-md-3 mb-3">
            <div class="text-primary"><%=fd.label%>:</div>
            <div><%=fd.choices ? fd.choices[field[fd.name]] : field[fd.name]%>
            </div>
          </div>
          <%}else{%>
          <div class="col-md-3 mb-3">
            <div class="text-primary"><%=fd.label%>:</div>
            <div><%=field[fd.name].display_value%>
            </div>
          </div>
          <%}%>
          <%}else if(field.type === "asset"){%>
          <%if(fd.name !== "reference_model"){%>
          <div class="col-md-3 mb-3">
            <div class="text-primary"><%=fd.label%>:</div>
            <div><%=fd.choices ? fd.choices[field[fd.name]] : field[fd.name]%>
            </div>
          </div>
          <%}%>
              <%}else{%>
          <%if(fd.name !== "reference_model" && fd.name !== "reference_type"){%>
          <div class="col-md-3 mb-3">
            <div class="text-primary"><%=fd.label%>:</div>
            <div><%=fd.choices ? fd.choices[field[fd.name]] : field[fd.name]%>
            </div>
          </div>
          <%}%>
            <%}%>
          <%})%>
        </div>
      </div>
    </div>
  </div>
</div>
<%})%>
<%}%>
<div class="row">
  <div class="col-12">
    <button data-bs-toggle="modal" data-bs-target="#save_field_modal" class="btn add_field_btn w-100 shadow">
        <i class="bi bi-plus-circle me-2"></i>Add Field
    </button>
  </div>
</div>

<%-include('../partials/container_end.ejs')%>
<%}else{%>
<div class="empty_state_wrapper">
  <div></div>
  <div>No model found</div>
</div>
<%}%>
    
<%-include('../partials/base/modals/model.ejs')%>
<%-include('../partials/base/modals/field.ejs')%>


<script type="module">
  import ModelUtil from "/scripts/utils/ModelUtil.js";
  (() => {
    const modelUtil = new ModelUtil();
    const editFieldBtns = document.querySelectorAll("[data-action='edit_field']");
    const deleteFieldBtns = document.querySelectorAll("[data-action='delete_field']");

    editFieldBtns.forEach((btn) => {
      btn.onclick = (evt) => {
        evt.stopPropagation();
        evt.preventDefault();
        try {
          let field = JSON.parse(btn.getAttribute("data-field_data"));
          let saveFieldModal = document.querySelector("#save_field_modal");
          let saveFieldForm = saveFieldModal.querySelector('[name="save_field_form"]');
          for (let prop in field) {
            let formField = saveFieldForm.querySelector(`[name='${prop}']`);
            if (formField) {
              if(prop === "reference_model" && field[prop] && field[prop].display_value){
                formField.closest("[data-lookup_wrapper]").querySelector(`[data-lookup='sys_model']`).value = field[prop].display_value;
                formField.value = field[prop].value;
              }else{
                formField.value = field[prop];
              }
              let event = new Event("change");
              formField.dispatchEvent(event);
            }
          }

          let fieldIdInput = saveFieldForm.querySelector('[name="field_id"]');
          if (!fieldIdInput) return;
          fieldIdInput.value = `${field._id}`;

          let bsSaveModal = new bootstrap.Modal(document.getElementById("save_field_modal"), {
            keyboard: false
          });
          bsSaveModal.show();
        } catch (error) {
          console.log(error);
        }
      }
    });

    deleteFieldBtns.forEach((btn) => {
      btn.onclick = async (evt) => {
        evt.preventDefault();
        try {
          let field = JSON.parse(btn.getAttribute("data-field_data"));
          let confirmDelete = confirm(`Are you sure you want to delete field: ${field.name}`);
          if (!confirmDelete) return;
          btn.disabled = true;
          let field_id = btn.getAttribute("data-field_id");
          let res = await modelUtil.deleteField("<%=model._id%>", {
            record_id: `${field_id}`
          });
        } catch (error) {
          console.log(error);
        }

        Turbo.visit(`/<%=locals.base._id%>/models/<%=model._id%>`);
      }
    });

  })()
</script>