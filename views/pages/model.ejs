
<%if(typeof model !== "undefined"){%>

    <% 
 const fieldDefinitions = [
  {
    label:"Label",
    name:"label"
  },
  {
    label:"Name",
    name:"name"
  },
  {
    label:"Type",
    name:"type",
    type:"choice",
    choices:{
        single_line_text:"Single Line Text",
        checkbox:"Checkbox"
    }
  },
  {
    label:"Mandatory",
    name:"mandatory",
    type:"choice",
    choices:{yes:"Yes",no:"No"}
  },
  {
    label:"Hidden On Form",
    name:"hidden_on_form",
    type:"choice",
    choices:{yes:"Yes",no:"No"}
  }
];
 %>
<%-include('../partials/container_start.ejs')%>
<div class="row mb-3">
  <div class="d-flex align-items-center justify-content-between">
    <div>
      <button data-bs-toggle="modal" data-bs-target="#save_field_modal" class="btn btn-primary shadow">
        <i class="bi bi-plus-circle me-2"></i>Add Field
      </button>
    </div>
    <div class="d-flex align-items-center d-none">
      <button class="btn text-white"><i class="bi bi-grid me-1"></i></button>
      <button class="btn text-white"><i class="bi bi-list"></i></button>
    </div>
  </div>
</div>
<%if(typeof fields !== "undefined"){%>
<%fields.forEach((field)=>{%>
<div class="row mb-3">
  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <div class="card-title">
          <%=field.label%>
        </div>
      </div>
      <div class="card-body">
        <div class="row">
            <%fieldDefinitions.forEach((fd)=>{%>
            <div class="col-md-3 mb-3">
                    <span class="text-muted"><%=fd.label%>: </span><%=fd.choices ? fd.choices[field[fd.name]] : field[fd.name]%>
            </div>
             <%})%>
        </div>
      </div>
    </div>
  </div>
</div>
<%})%>
<%}%>
<div class="row">
  <div class="col-12">
    <button data-bs-toggle="modal" data-bs-target="#save_field_modal" class="btn add_field_btn w-100 shadow">
        <i class="bi bi-plus-circle me-2"></i>Add Field
    </button>
  </div>
</div>

<%-include('../partials/container_end.ejs')%>
<%}else{%>
<div class="empty_state_wrapper">
  <div></div>
  <div>No model found</div>
</div>
<%}%>
    
<%-include('../partials/base/modals/model.ejs')%>
<%-include('../partials/base/modals/field.ejs')%>