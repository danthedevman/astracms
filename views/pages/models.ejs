<%if(typeof models !== "undefined" && models.length > 0){%>
<%-include('../partials/container_start.ejs')%>
<div class="row">
  <%models.forEach((model)=>{%>
  <div class="col-md-6 mb-3">
    <div class="card shadow">
      <div class="card-header d-flex align-items-center justify-content-between">
        <div class="card-title">
          <%=model.name%>
        </div>
      </div>
      <div class="card-body">
        <div>
          <label class="text-muted">Description</label>
          <div><%=model.description%></div>
        </div>
      </div>
      <div class="card-footer">
        <div class="d-flex align-items-center justify-content-between">
          <button data-model_id="<%=model._id%>" data-action="delete_model" class="btn btn-danger btn-sm me-2">
            Delete
          </button>
          <a href="/<%=locals.base._id%>/models/<%=model._id%>" class="btn btn-primary btn-sm">
            Edit
          </a>
        </div>
      </div>
    </div>
  </div>
  <%})%>
</div>

<%-include('../partials/container_end.ejs')%>
<%}else{%>
<div class="empty_state_wrapper">
  <div></div>
  <div>No models found</div>
</div>
<%}%>

<%-include('../partials/base/modals/add_model.ejs')%>

<script>
    (() => {
      const deleteAssetBtns = document.querySelectorAll('[data-action="delete_model"]');
      deleteAssetBtns.forEach((btn) => {
        btn.onclick = async (evt) => {
          evt.preventDefault();
          let asset_id = btn.getAttribute("data-model_id");
          let res = await fetch(`/${window._astracms.base_id}/models/${asset_id}/delete`, {
            method: "DELETE",
            credentials: "same-origin",
            headers: {
              "Content-Type": "application/json",
            },
          });
  
          if (res.status === 200) {
              if (Turbo) {
                Turbo.visit(`${document.location.pathname}${document.location.search}`);
              }
            }
        }
      })
    })()
  </script>