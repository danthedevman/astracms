<%if(typeof models !== "undefined" && models.length > 0){%>
<%-include('../partials/container_start.ejs')%>
<div class="row mb-3">
  <div class="col-12">
    <%-include('../partials/search/search_and_sort.ejs')%>
  </div>
</div>
<div class="row">
  <%models.forEach((model)=>{%>
  <div class="col-md-6 mb-3">
    <div class="card shadow">
      <div class="card-header d-flex align-items-center justify-content-between">
        <div class="card-title">
          <%=model.label%>
        </div>
      </div>
      <div class="card-body" style="height:100px;">
        <div>
          <label class="text-muted">Description</label>
          <div style="overflow:hidden;text-overflow: ellipsis;
          display: -webkit-box;
          -webkit-line-clamp: 2;
          -webkit-box-orient: vertical;"><%=model.description || model.label%></div>
        </div>
      </div>
      <div class="card-footer">
        <div class="d-flex align-items-center justify-content-end">
          <button data-model_label="<%=model.label%>" data-model_id="<%=model._id%>" data-action="delete_model" class="btn btn-danger btn-sm me-2 d-none">
            Delete
          </button>
          <a href="/<%=locals.base._id%>/models/<%=model._id%>" class="btn btn-primary btn-sm">
            <i class="bi bi-pencil me-2"></i>Edit
          </a>
        </div>
      </div>
    </div>
  </div>
  <%})%>
</div>

<%-include('../partials/container_end.ejs')%>
<%}else{%>
<div class="empty_state_wrapper">
  <div></div>
  <div>No models found</div>
</div>
<%}%>

<%-include('../partials/base/modals/model.ejs')%>

<script>
    (() => {
      const deleteModelBtns = document.querySelectorAll('[data-action="delete_model"]');
      deleteModelBtns.forEach((btn) => {
        btn.onclick = async (evt) => {
          evt.preventDefault();
          btn.setAttribute("disabled",true);
          const confirmDelete = confirm(`Are you sure you want to delete model ${btn.getAttribute("data-model_label")}?`);
          if(!confirmDelete){
            btn.removeAttribute("disabled");
            return;
          }
          let model_id = btn.getAttribute("data-model_id");
          let res = await fetch(`/${window._astracms.base_id}/models/${model_id}/delete`, {
            method: "DELETE",
            credentials: "same-origin",
            headers: {
              "Content-Type": "application/json",
            },
          });
  
          if (res.status === 200) {
              if (Turbo) {
                Turbo.visit(`${document.location.pathname}${document.location.search}`);
              }
            }
        }
      });
    })()
  </script>