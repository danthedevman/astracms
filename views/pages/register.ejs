<div class="container" style="margin-top:100px;">
  <div class="row">
    <div class="col-4 offset-4">
      <div class="form_wrapper">
        <form class="border shadow-sm">
        <div class="text-center bg-dark p-3">
            <%-include('../partials/logo.ejs')%>
        </div>
        <div class="pt-3 pb-5 px-5">
            <div class="form-group mb-3">
                <label>Name</label>
                <input type="text" class="form-control" name="name" placeholder="Enter your name" />
              </div>
              <div class="form-group mb-3">
                <label>Email</label>
                <input type="text" class="form-control" name="email" placeholder="Enter your email" />
              </div>
              <div class="form-group mb-3">
                <label>Password</label>
                <input type="text" class="form-control" name="password" placeholder="Enter a password" />
              </div>
              <button type="button" data-action="register" class="btn btn-primary w-100">Register</button>
        </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script>
  (() => {
    const registerBtn = document.querySelector("[data-action='register']");
    registerBtn.onclick = async (evt) => {
      evt.preventDefault();
      let name = document.querySelector("[name='name']").value;
      let email = document.querySelector("[name='email']").value;
      let pw = document.querySelector("[name='password']").value;
      let res = await fetch("/register", {
        method: "POST",
        credentials: "same-origin",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({
            name,
            email,
            pw
        }),
      });
    };

  })();
</script>