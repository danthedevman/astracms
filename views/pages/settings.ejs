<%-include('../partials/container_start.ejs')%>
<div class="row">
  <div class="col-12">
    <div class="settings_tabs_wrapper">
      <ul class="nav nav-tabs" id="myTab" role="tablist">
        <li class="nav-item" role="presentation">
          <button class="nav-link active" id="home-tab" data-bs-toggle="tab" data-bs-target="#home" type="button" role="tab" aria-controls="home" aria-selected="true">General</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="false">Developer</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profile" type="button" role="tab" aria-controls="profile" aria-selected="false">Users</button>
        </li>
        <li class="nav-item" role="presentation">
          <button class="nav-link" id="contact-tab" data-bs-toggle="tab" data-bs-target="#contact" type="button" role="tab" aria-controls="contact" aria-selected="false">Billing</button>
        </li>
      </ul>
      <div class="tab-content mt-3" id="myTabContent">
        <div class="tab-pane fade show active" id="home" role="tabpanel" aria-labelledby="home-tab">
          <form class="mb-3">
            <div class="mb-3 col-md-6" data-form_group>
              <label>Base Name</label>
              <input type="text" class="form-control" value="<%=locals.base.name%>" />
            </div>
            <div  class="mb-3">
              <label>Base Description</label>
              <textarea class="form-control"><%=locals.base.description%></textarea>
            </div>
            <button type="button" class="btn btn-primary" data-action="save_base_details" disabled>Save</button>
          </form>
          <hr style="background:rgba(255,255,255,.90);"/>
          <div class="card danger_zone_wrapper bg-outline-danger">
            <div class="card-body">

            </div>
          </div>
        </div>
        <div class="tab-pane fade" id="profile" role="tabpanel" aria-labelledby="profile-tab">

          <form class="mb-3">
            <div>
              <label>API Key</label>
              <input type="text" class="form-control" />
            </div>
            <div>
  
            </div>
          </form>

        </div>
        <div class="tab-pane fade" id="contact" role="tabpanel" aria-labelledby="contact-tab">...</div>
        <div class="tab-pane fade" id="contact" role="tabpanel" aria-labelledby="contact-tab">...</div>
      </div>
    </div>
  </div>
</div>

<%-include('../partials/container_end.ejs')%>