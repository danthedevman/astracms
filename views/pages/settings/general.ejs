<%-include('../../partials/container_start.ejs')%>
<div class="row mb-3">
  <div class="col-12">
    <%-include("./settings_tab_links.ejs")%>
  </div>
</div>
<div class="row">
  <div class="col-12">
    <div>
      <form name="base_details_form" class="mb-3">
        <div class="mb-3 col-md-6" data-form_group>
          <label>Base Name<small class="ms-1 text-secondary">(required)</small></label>
          <input data-mandatory="true" name="base_name" type="text" class="form-control" value="<%=locals.base.name%>" />
        </div>
        <div class="mb-3">
          <label>Base Description<small class="ms-1 text-secondary">(optional)</small></label>
          <textarea name="base_description" class="form-control"><%=locals.base.description%></textarea>
        </div>
        <button type="button" class="btn btn-primary" data-action="save_base_details">Save</button>
      </form>
      <hr style="background:rgba(255,255,255,.90);" />
      <div class="card danger_zone_wrapper bg-outline-danger">
        <div class="card-header d-none">
          <div class="card-title">
            Danger Zone
          </div>
        </div>
        <div class="card-body">
          <div class="h3 text-primary">Delete Base</div>
          <div class="mb-3">Deleting a base cannot be reverted and all content will be deleted.</div>
          <div><button data-action="delete_base" class="btn btn-danger"><i class="bi bi-trash me-1"></i>Delete</button></div>
        </div>
      </div>
    </div>

  </div>
</div>
<%-include('../../partials/container_end.ejs')%>
<script type="module">
  import FormUtil from "/scripts/utils/FormUtil.js";
  (() => {
    const saveBaseDetailsBtn = document.querySelector(`[data-action='save_base_details']`);
    saveBaseDetailsBtn.onclick = async (evt) => {
      evt.preventDefault();
      const formUtil = new FormUtil({
        selector: "[name='base_details_form']"
      }).init();

      if (!formUtil.canSubmit()) {
        return;
      }

      const form_data = new FormData(formUtil.form);

      const res = await fetch(`/${window._astracms.base_id}/settings/general/save_base_details`, {
        method: "POST",
        credentials: "same-origin",
        body: form_data,
      });

      if (Turbo && res.status === 200) {
        Turbo.visit(`/<%=locals.base._id%>/settings/general`);
        return;
      }
    
    };

    const deleteBaseBtn = document.querySelector(`[data-action='delete_base']`);
    deleteBaseBtn.onclick = async (evt) => {
      evt.preventDefault();
      let confirmDelete = confirm("Once you delete this base all content will be deleted and any reference to this base via API queries made from your applications will no longer work. All users currently associated with this base will no longer be able to access. Are you sure you wish to continue?");
      if(!confirmDelete) return;
      const res = await fetch(`/${window._astracms.base_id}/settings/general/delete_base`, {
        method: "DELETE",
        credentials: "same-origin"
      });

      Turbo.visit("/");
      
    };


  })();
</script>