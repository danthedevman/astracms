<div class="modal" tabindex="-1" id="add_field_modal" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Field</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form name="add_field_form">
          <div class="row">
            <div class="col-md-6">
              <div data-form_group="label" class="mb-3">
                <label for="label" class="form-label">Label (required)</label>
                <input data-mandatory="true" type="type" class="form-control" name="label" placeholder="Enter a label for your field...">
              </div>
              <div data-form_group="type" class="mb-3">
                <label for="label" class="form-label">Type (required)</label>
                <select data-mandatory="true" class="form-select">
                  <option selected value="">-Select-</option>
                  <option value="single_line_text">Single Line Text</option>
                  <option value="multi_line_text">Multi Line Text</option>
                  <option value="rich_text">Rich Text</option>
                  <option value="choice">Choice</option>
                  <option value="choice">Number</option>
                  <option value="asset">Asset</option>
                  <option value="choice">Reference</option>
                </select>
              </div>
              <div data-form_group="mandatory" class="mb-3">
                <label for="label" class="form-label">Mandatory</label>
                <select class="form-select">
                  <option selected value="no">No</option>
                  <option value="yes">Yest</option>
                </select>
              </div>
            </div>
            <div class="col-md-6">
              <div data-form_group="name" class="mb-3">
                <label for="name" class="form-label">Name (required)</label>
                <input data-mandatory="true" type="type" class="form-control" name="name" placeholder="">
              </div>
              <div data-form_group="select_model" class="mb-3 d-none">
                <label for="name" class="form-label">Select Model</label>
                <select class="form-select">
                  <option selected value="no">No</option>
                  <option value="yes">Yest</option>
                </select>
              </div>
              <div data-form_group="title_field" class="mb-3">
                <label for="name" class="form-label">Title Field</label>
                <select class="form-select">
                  <option selected value="no">No</option>
                  <option value="yes">Yest</option>
                </select>
              </div>
              <div data-form_group="hidden_on_form" class="mb-3">
                <label for="name" class="form-label">Hidden On Form</label>
                <select class="form-select">
                  <option selected value="no">No</option>
                  <option value="yes">Yest</option>
                </select>
              </div>
            </div>
          </div>
          <!--row 2-->
          <div class="row">
            <div class="forn_group">
              <label class="form-label">Choices</label>
              <div id="choice_list" class="choice_list_wrapper">
                <div data-order="100" class="choice_list_row mb-2 row">
                  <div class="col-6">
                    <div class="d-flex align-items-center">
                      <button type="button" class="btn grip_btn me-2"><i class="bi bi-grip-vertical"></i></button>
                      <input class="form-control" type="text" placeholder="Label">
                    </div>
                  </div>
                  <div class="col-6">
                    <div class="d-flex align-items-center">
                      <input class="form-control" type="text" placeholder="Value">
                      <button data-action="remove_choice" class="btn-sm btn-danger ms-2"><i class="bi bi-trash"></i></button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="choice_add_btn_wrapper mt-3">
                <button data-action="add_choice" class="btn btn-primary w-100">Add Choice</button>
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer d-flex align-items-center justify-content-between">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <button data-action="add_model" type="button" class="btn btn-primary">Confirm</button>
      </div>
    </div>
  </div>
</div>
<script type="module">
  import FormUtil from "/scripts/utils/FormUtil.js";
  import ModelUtil from "/scripts/utils/ModelUtil.js";
  (() => {
    const form = new FormUtil({
      selector: "[name='add_field_form']"
    }).init();
    const addBaseBtn = document.querySelector("[data-action='add_model']");
    addBaseBtn.onclick = async (evt) => {
      evt.preventDefault();
      if (!form.canSubmit()) {
        return;
      }

      let res = await new ModelUtil().createModel({
        name: form.getValue("[name='name']"),
        description: form.getValue("[name='description']")
      });

      if (Turbo && res.status === 200) {
        let json = await res.json();
        console.log(json);
        Turbo.visit(`/<%=locals.base._id%>/models/${json.record_id}`);
      }
    }

    const add_model_modal = document.getElementById('add_field_modal');
    add_model_modal.addEventListener('hidden.bs.modal', function(event) {
      form.reset();
    });

    const choiceList = document.getElementById("choice_list");

    choiceList.querySelector('[data-action="remove_choice"]').onclick = (evt) => {
      evt.preventDefault();
      evt.currentTarget.closest(".choice_list_row").querySelectorAll("input").forEach(element => {
        element.value = "";
      });
    };

    add_model_modal.querySelector('[data-action="add_choice"]').onclick = (evt) => {
      evt.preventDefault();
      let x = document.querySelector(".choice_list_row");

      let y = x.cloneNode(true);

      y.querySelectorAll("input").forEach(element => {
        element.value = "";
      });

      y.querySelector('[data-action="remove_choice"]').onclick = (evt) => {
        y.remove();
      };

      y.querySelector('[data-action="remove_choice"]').classList.remove("d-none");
      new Sortable(document.getElementById("choice_list"), {
        animation: 150,
        ghostClass: 'sortable-ghost',
        onEnd: function(evt) {
          let choiceArr = Array.from(evt.target.children);
          choiceArr.forEach((choice, i) => {
            choice.setAttribute("data-order", (i + 1) * 100);
          });

        }
      });

      x.parentNode.appendChild(y);
    }

  })()
</script>