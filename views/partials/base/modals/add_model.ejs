<div class="modal" tabindex="-1" id="add_model_modal">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Add Model</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <div class="modal-body">
          <form name="add_model_form">
            <div data-form_group class="mb-3">
              <label for="base_name" class="form-label">Name (required)</label>
              <input data-mandatory="true" type="type" class="form-control" name="name" placeholder="Enter a name for you model...">
            </div>
            <div data-form_group class="mb-3">
              <label for="base_description" class="form-label">Description (optional)</label>
              <textarea class="form-control" name="description"></textarea>
            </div>
          </form>
        </div>
        <div class="modal-footer d-flex align-items-center justify-content-between">
          <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
          <button data-action="add_model" type="button" class="btn btn-primary">Confirm</button>
        </div>
      </div>
    </div>
  </div>
  <script type="module">
    import FormUtil from "../scripts/utils/FormUtil.js";
    import ModelUtil from "../scripts/utils/ModelUtil.js";
    (() => {
      const form = new FormUtil({
        selector: "[name='add_model_form']"
      }).init();
      const addBaseBtn = document.querySelector("[data-action='add_model']");
      addBaseBtn.onclick = (evt) => {
        evt.preventDefault();
        if (!form.canSubmit()) {
          return;
        }
        new ModelUtil().createModel({
          name: form.getValue("[name='name']"),
          description: form.getValue("[name='description']")
        });
  
        if (Turbo) {
          Turbo.visit(`${document.location.pathname}${document.location.search}`);
        }
      }
  
      const add_model_modal = document.getElementById('add_model_modal');
      add_model_modal.addEventListener('hidden.bs.modal', function(event) {
        form.reset();
      })
    })()
  </script>