<div class="modal" tabindex="-1" id="save_field_modal" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%=typeof field !== 'undefined' ? 'Edit' : 'Add'%> Field</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form name="save_field_form">
          <div class="row">
            <div class="col-md-6">
              <div data-form_group="label" class="mb-3">
                <label for="label" class="form-label">Label (required)</label>
                <input data-mandatory="true" type="text" class="form-control" name="label" placeholder="Enter a label for your field...">
              </div>
              <div data-form_group="type" class="mb-3">
                <label for="label" class="form-label">Type (required)</label>
                <select name="type" id="field_type" data-mandatory="true" class="form-select">
                  <option selected value="">-Select-</option>
                  <option value="single_line_text">Single Line Text</option>
                  <option value="multi_line_text">Multi Line Text</option>
                  <option value="rich_text">Rich Text</option>
                  <option value="choice">Choice</option>
                  <option value="number">Number</option>
                  <option value="checkbox">Checkbox</option>
                  <option value="yes_no">Yes/No</option>
                  <option value="asset">Asset</option>
                  <option value="reference">Reference</option>
                </select>
              </div>
              <div data-form_group="reference_type" class="mb-3 d-none">
                <label for="name" class="form-label">Reference Type</label>
                <select name="reference_type" data-mandatory="false" class="form-select">
                  <option selected value="single">Single Record</option>
                  <option value="multiple">Multiple Records</option>
                </select>
              </div>
              <div data-form_group="mandatory" class="mb-3">
                <label for="label" class="form-label">Mandatory</label>
                <select name="mandatory" class="form-select">
                  <option selected value="no">No</option>
                  <option value="yes">Yes</option>
                </select>  
              </div>
            </div>
            <div class="col-md-6">
              <div data-form_group="name" class="mb-3">
                <label for="name" class="form-label">Name (required)</label>
                <input data-mandatory="true" type="text" class="form-control" name="name" placeholder="">
              </div>
              <div data-form_group="reference" class="mb-3 d-none">
                <label for="name" class="form-label">Select Model</label>
                  <%-include(`../../../partials/fields/reference.ejs`,{field:{type:"reference",name:"reference_model",reference_model:"sys_model"}})%>
              
              </div>
              <div data-form_group="title_field" class="mb-3">
                <label for="name" class="form-label">Title Field</label>
                <select name="title_field" class="form-select">
                  <option <%if(typeof fields !== "undefined" && fields.length > 0){%>selected<%}%> value="no">No</option>
                  <option <%if(typeof fields === "undefined" || fields.length === 0){%>selected<%}%> value="yes">Yes</option>
                </select>
              </div>
              <div data-form_group="hidden_on_form" class="mb-3">
                <label for="name" class="form-label">Hidden On Form</label>
                <select name="hidden_on_form" class="form-select">
                  <option selected value="no">No</option>
                  <option value="yes">Yes</option>
                </select>
              </div>
            </div>
          </div>
          <!--row 2-->
          <div data-choices_macro class="row d-none">
            <div class="form_group">
              <label class="form-label">Choices</label>
              <div id="choice_list" class="choice_list_wrapper">
                <div data-order="100" class="choice_list_row mb-2 row">
                  <div data-form_group class="col-6">
                    <div class="d-flex align-items-center">
                      <button type="button" class="btn grip_btn me-2"><i class="bi bi-grip-vertical"></i></button>
                      <input data-mandatory="false" class="form-control" type="text" placeholder="Label">
                    </div>
                  </div>
                  <div data-form_group class="col-6">
                    <div class="d-flex align-items-center">
                      <input data-mandatory="false" class="form-control" type="text" placeholder="Value">
                      <button data-action="remove_choice" class="btn-sm btn-danger ms-2"><i class="bi bi-trash"></i></button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="choice_add_btn_wrapper mt-3">
                <button data-action="add_choice" class="btn btn-primary w-100">Add Choice</button>
              </div>
            </div>
          </div>
          <input type="hidden" name="field_id" value=""/>
        </form>
      </div>
      <div class="modal-footer d-flex align-items-center justify-content-between">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <button data-action="save_field" type="button" class="btn btn-primary">Confirm</button>
      </div>
    </div>
  </div>
</div>
<script type="module">
  import FormUtil from "/scripts/utils/FormUtil.js";
  import ModelUtil from "/scripts/utils/ModelUtil.js";
  (() => {

    let deferLookup;
    const form = new FormUtil({
      selector: "[name='save_field_form']"
    }).init();

    const saveFieldBtn = document.querySelector("[data-action='save_field']");
    saveFieldBtn.onclick = async (evt) => {
      evt.preventDefault();
      if (!form.canSubmit()) {
        return;
      }

      let res = await new ModelUtil().saveField("<%=model._id%>",{
        label: form.getValue("[name='label']"),
        name: form.getValue("[name='name']"),
        type: form.getValue("[name='type']"),
        title_field: form.getValue("[name='title_field']"),
        mandatory: form.getValue("[name='mandatory']"),
        hidden_on_form: form.getValue("[name='hidden_on_form']"),
        reference_type: form.getValue("[name='reference_type']"),
        reference_model: form.getValue("[name='reference_model']"),
        field_id:form.getValue("[name='field_id']")
      });

      if (Turbo && res.status === 200) {
        let json = await res.json();
        console.log(json);
        Turbo.visit(`/<%=locals.base._id%>/models/${json.record_id}`);
      }
    }

    const save_field_modal = document.getElementById('save_field_modal');
    save_field_modal.addEventListener('hidden.bs.modal', function(event) {
      form.reset();
      resetHiddenFields();
    });

    const choiceList = document.getElementById("choice_list");

    choiceList.querySelector('[data-action="remove_choice"]').onclick = (evt) => {
      evt.preventDefault();
      evt.currentTarget.closest(".choice_list_row").querySelectorAll("input").forEach(element => {
        element.value = "";
      });
    };

    save_field_modal.querySelector('[data-action="add_choice"]').onclick = (evt) => {
      evt.preventDefault();
      let x = document.querySelector(".choice_list_row");

      let y = x.cloneNode(true);

      y.querySelectorAll("input").forEach(element => {
        element.value = "";
      });

      y.querySelector('[data-action="remove_choice"]').onclick = (evt) => {
        y.remove();
      };

      y.querySelector('[data-action="remove_choice"]').classList.remove("d-none");
      new Sortable(document.getElementById("choice_list"), {
        animation: 150,
        ghostClass: 'sortable-ghost',
        onEnd: function(evt) {
          let choiceArr = Array.from(evt.target.children);
          choiceArr.forEach((choice, i) => {
            choice.setAttribute("data-order", (i + 1) * 100);
          });

        }
      });

      x.parentNode.appendChild(y);
      form.init();
    }

    const fieldType = document.getElementById("field_type");
    const choiceMacro = document.querySelector("[data-choices_macro]");
    const reference =  document.querySelector('[data-form_group="reference"]');
    const reference_type =  document.querySelector('[data-form_group="reference_type"]');

    if (fieldType.value === "choice") {
      choiceMacro.classList.remove("d-none");
    }

    function resetHiddenFields(){
        form.getElement("[data-choices_macro]").classList.add("d-none");
        form.getElement('[data-form_group="reference"]').classList.add("d-none");
        form.getElement('[data-form_group="reference_type"]').classList.add("d-none");
        form.getElement('[data-form_group="reference"]').querySelector("[data-mandatory]").setAttribute("data-mandatory",false);
        form.getElement(`[name="field_id"]`).value="";
        // document.querySelector('[data-form_group="reference_type"]').querySelector("[data-mandatory]").setAttribute("data-mandatory",false);
    }

    fieldType.onchange = (evt) => {
        resetHiddenFields()
      if (fieldType.value === "choice") {
        choiceMacro.classList.remove("d-none");
      }

      if (fieldType.value === "reference") {
        reference.querySelector("[data-mandatory]").setAttribute("data-mandatory",true);
        //reference_type.querySelector("[data-mandatory]").setAttribute("data-mandatory",true);
        //reference_type.setAttribute("data-mandatory",true);
        document.querySelector('[data-form_group="reference"]').classList.remove("d-none");
        document.querySelector('[data-form_group="reference_type"]').classList.remove("d-none");
      }

      if (fieldType.value === "asset") {
        reference_type.querySelector("[data-mandatory]").setAttribute("data-mandatory",true);
        document.querySelector('[data-form_group="reference_type"]').classList.remove("d-none");
      }

      form.init();

    };

    function resetChoicesMacro() {
      let macro = document.querySelector("[data-choices_macro]");
      let choiceList = macro.querySelector("#choice_list");
      while (choiceList.children.length > 1) {
        choiceList.removeChild(choiceList.lastChild);
      }

      choiceList.querySelectorAll("input").forEach(element => {
        element.value = "";
      });

      macro.classList.add("d-none");

    }

    let labelInput = form.getElement(`[name="label"]`);
    let nameInput =  form.getElement(`[name="name"]`);
    let recordIdInput = form.getElement(`[name="field_id"]`);
    labelInput.oninput = (evt)=>{
      if(recordIdInput.value){
          return;
      }

      nameInput.value = String(labelInput.value).toLowerCase().replace(/\s/g,"_");
    };

  })()
</script>