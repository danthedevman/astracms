<div class="modal" tabindex="-1" id="save_field_modal" data-bs-backdrop="static">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title"><%=typeof field !== 'undefined' ? 'Edit' : 'Add'%> Field</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form name="save_field_form">
          <div class="row">
            <div class="col-md-6">
              <div data-form_group="label" class="mb-3">
                <label for="label" class="form-label">Label (required)</label>
                <input data-mandatory="true" type="text" class="form-control" name="label" placeholder="Enter a label for your field...">
              </div>
              <div data-form_group="type" class="mb-3">
                <label for="label" class="form-label">Type (required)</label>
                <select id="field_type" data-mandatory="true" class="form-select">
                  <option selected value="">-Select-</option>
                  <option value="single_line_text">Single Line Text</option>
                  <option value="multi_line_text">Multi Line Text</option>
                  <option value="rich_text">Rich Text</option>
                  <option value="choice">Choice</option>
                  <option value="number">Number</option>
                  <option value="checkbox">Checkbox</option>
                  <option value="yes_no">Yes/No</option>
                  <option value="asset">Asset</option>
                  <option value="reference">Reference</option>
                </select>
              </div>
              <div data-form_group="reference_type" class="mb-3 d-none">
                <label for="name" class="form-label">Reference Type</label>
                <select data-mandatory="false" class="form-select">
                  <option selected value="single">Single Record</option>
                  <option value="multiple">Multiple Records</option>
                </select>
              </div>
              <div data-form_group="mandatory" class="mb-3">
                <label for="label" class="form-label">Mandatory</label>
                <select class="form-select">
                  <option selected value="no">No</option>
                  <option value="yes">Yes</option>
                </select>

                <div class="dropdown w-100 d-none">
                  <button class="btn form-control d-flex align-items-center justify-content-between w-100" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
                    <div>No</div>
                    <div><i class="bi bi-chevron-down"></i><i class="bi bi-chevron-up d-none"></i></div>
                  </button>
                  <ul style="width:100%;max-height:200px;overflow-y: auto;" class="dropdown-menu bg-dark p-3" aria-labelledby="dropdownMenuButton1">
                    <li class="mb-2"><a class="w-100 d-block" href="javascript:void(0)" data-value="yes">Yes</a></li>
                    <li class=""><a class="w-100 d-block" href="javascript:void(0)"  data-value="no">No</a></li>
                  </ul>
                  <input data-mandatory="false" value="no" type="hidden"  />
                </div>

                
              </div>
            </div>
            <div class="col-md-6">
              <div data-form_group="name" class="mb-3">
                <label for="name" class="form-label">Name (required)</label>
                <input data-mandatory="true" type="text" class="form-control" name="name" placeholder="">
              </div>
              <div data-form_group="select_model" class="mb-3 d-none">
                <label for="name" class="form-label">Select Model</label>
               <!--<input data-mandatory="false" type="text" class="form-control d-none" name="lookup_model" placeholder="Select a model...">-->
              
                <div data-lookup_wrapper class="dropdown w-100">
                  <input data-lookup="sys_model" autofocus data-lookup_search class="form-control rounded-0" id="lookup_sys_model" placeholder="Search..." data-dropdown_btn/>
                  <!--<button data-lookup="sys_model" class="btn form-control d-flex align-items-center justify-content-between w-100" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
                    <div>-Select-</div>
                    <div><i class="bi bi-search"></i></div>
                  </button>-->
                  <ul class="dropdown-menu bg-dark p-0 w-100" aria-labelledby="dropdownMenuButton1">
                    <li></li>
                    <li class="mb-2 p-3">
                      <ul data-lookup_results class="list-group bg-dark p-0" style="width:100%;max-height:200px;overflow-y: auto;">
                      </ul>
                    </li>
                  </ul>
                  <input data-mandatory="false" value="" name="lookup_model" type="hidden"  />
                </div>
              
              </div>
              <div data-form_group="title_field" class="mb-3">
                <label for="name" class="form-label">Title Field</label>
                <select class="form-select">
                  <option selected value="no">No</option>
                  <option value="yes">Yes</option>
                </select>
              </div>
              <div data-form_group="hidden_on_form" class="mb-3">
                <label for="name" class="form-label">Hidden On Form</label>
                <select class="form-select">
                  <option selected value="no">No</option>
                  <option value="yes">Yes</option>
                </select>
              </div>
            </div>
          </div>
          <!--row 2-->
          <div data-choices_macro class="row d-none">
            <div class="form_group">
              <label class="form-label">Choices</label>
              <div id="choice_list" class="choice_list_wrapper">
                <div data-order="100" class="choice_list_row mb-2 row">
                  <div data-form_group class="col-6">
                    <div class="d-flex align-items-center">
                      <button type="button" class="btn grip_btn me-2"><i class="bi bi-grip-vertical"></i></button>
                      <input data-mandatory="true" class="form-control" type="text" placeholder="Label">
                    </div>
                  </div>
                  <div data-form_group class="col-6">
                    <div class="d-flex align-items-center">
                      <input data-mandatory="true" class="form-control" type="text" placeholder="Value">
                      <button data-action="remove_choice" class="btn-sm btn-danger ms-2"><i class="bi bi-trash"></i></button>
                    </div>
                  </div>
                </div>
              </div>
              <div class="choice_add_btn_wrapper mt-3">
                <button data-action="add_choice" class="btn btn-primary w-100">Add Choice</button>
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer d-flex align-items-center justify-content-between">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <button data-action="add_model" type="button" class="btn btn-primary">Confirm</button>
      </div>
    </div>
  </div>
</div>
<script type="module">
  import FormUtil from "/scripts/utils/FormUtil.js";
  import ModelUtil from "/scripts/utils/ModelUtil.js";
  (() => {

    let deferLookup;
    const form = new FormUtil({
      selector: "[name='save_field_form']"
    }).init();

    const modelDropdownMenu = document.querySelector("#lookup_sys_model").closest(".dropdown").querySelector(".dropdown-menu")

    document.getElementById("lookup_sys_model").onkeyup = triggerLookup;


    function triggerLookup(evt){
      clearTimeout(deferLookup);
         deferLookup = setTimeout(async ()=>{
         let res = await fetch(`/<%=locals.base._id%>/${this.getAttribute("data-lookup")}/search?sys_text_search=${encodeURI(this.value)}`);

         if(res.status === 200){
          let json = await res.json();
          console.log(json);
          let template = "";
          json.results.forEach((result)=>{
            template+=`<li class="list-group-item border-0 bg-dark p-0""><a class="d-block w-100" data-result data-value="${result._id.toString()}" data-display_value="${result.label}" href="javascript:void(0)">${result.label}</a></li>`
          })
          const results = evt.target.closest(".dropdown").querySelector("[data-lookup_results]");
          results.innerHTML = template;
          evt.target.closest(".dropdown").querySelectorAll("[data-result]").forEach((r)=>{
            r.onclick = (e)=>{
              e.preventDefault();
              evt.target.closest(".dropdown").querySelector("[data-lookup]").setAttribute("data-value",r.getAttribute("data-value"))
              evt.target.closest(".dropdown").querySelector("[data-lookup]").value = r.getAttribute("data-display_value");
         modelDropdownMenu.classList.remove("show");
            };
          });
         }

         modelDropdownMenu.classList.add("show");

         },600);

    }

    const addBaseBtn = document.querySelector("[data-action='add_model']");
    addBaseBtn.onclick = async (evt) => {
      evt.preventDefault();
      if (!form.canSubmit()) {
        return;
      }

      let res = await new ModelUtil().createModel({
        name: form.getValue("[name='name']"),
        description: form.getValue("[name='description']")
      });

      if (Turbo && res.status === 200) {
        let json = await res.json();
        console.log(json);
        Turbo.visit(`/<%=locals.base._id%>/models/${json.record_id}`);
      }
    }

    const add_model_modal = document.getElementById('save_field_modal');
    add_model_modal.addEventListener('hidden.bs.modal', function(event) {
      form.reset();
      resetHiddenFields();
    });

    const choiceList = document.getElementById("choice_list");

    choiceList.querySelector('[data-action="remove_choice"]').onclick = (evt) => {
      evt.preventDefault();
      evt.currentTarget.closest(".choice_list_row").querySelectorAll("input").forEach(element => {
        element.value = "";
      });
    };

    add_model_modal.querySelector('[data-action="add_choice"]').onclick = (evt) => {
      evt.preventDefault();
      let x = document.querySelector(".choice_list_row");

      let y = x.cloneNode(true);

      y.querySelectorAll("input").forEach(element => {
        element.value = "";
      });

      y.querySelector('[data-action="remove_choice"]').onclick = (evt) => {
        y.remove();
      };

      y.querySelector('[data-action="remove_choice"]').classList.remove("d-none");
      new Sortable(document.getElementById("choice_list"), {
        animation: 150,
        ghostClass: 'sortable-ghost',
        onEnd: function(evt) {
          let choiceArr = Array.from(evt.target.children);
          choiceArr.forEach((choice, i) => {
            choice.setAttribute("data-order", (i + 1) * 100);
          });

        }
      });

      x.parentNode.appendChild(y);
      form.init();
    }

    const fieldType = document.getElementById("field_type");
    const choiceMacro = document.querySelector("[data-choices_macro]");
    const select_model =  document.querySelector('[data-form_group="select_model"]');
    const reference_type =  document.querySelector('[data-form_group="reference_type"]');

    if (fieldType.value === "choice") {
      choiceMacro.classList.remove("d-none");
    }

    function resetHiddenFields(){
        document.querySelector("[data-choices_macro]").classList.add("d-none");
        document.querySelector('[data-form_group="select_model"]').classList.add("d-none");
        document.querySelector('[data-form_group="reference_type"]').classList.add("d-none");
        document.querySelector('[data-form_group="select_model"]').querySelector("[data-mandatory]").setAttribute("data-mandatory",false);
       // document.querySelector('[data-form_group="reference_type"]').querySelector("[data-mandatory]").setAttribute("data-mandatory",false);
    }

    fieldType.onchange = (evt) => {
        resetHiddenFields()
      if (fieldType.value === "choice") {
        choiceMacro.classList.remove("d-none");
      }

      if (fieldType.value === "reference") {
        select_model.querySelector("[data-mandatory]").setAttribute("data-mandatory",true);
        //reference_type.querySelector("[data-mandatory]").setAttribute("data-mandatory",true);
        //reference_type.setAttribute("data-mandatory",true);
        document.querySelector('[data-form_group="select_model"]').classList.remove("d-none");
        document.querySelector('[data-form_group="reference_type"]').classList.remove("d-none");
      }

      if (fieldType.value === "asset") {
        reference_type.querySelector("[data-mandatory]").setAttribute("data-mandatory",true);
        document.querySelector('[data-form_group="reference_type"]').classList.remove("d-none");
      }

      form.init();

    };

    function resetChoicesMacro() {
      let macro = document.querySelector("[data-choices_macro]");
      let choiceList = macro.querySelector("#choice_list");
      while (choiceList.children.length > 1) {
        choiceList.removeChild(choiceList.lastChild);
      }

      choiceList.querySelectorAll("input").forEach(element => {
        element.value = "";
      });

      macro.classList.add("d-none");

    }

  })()
</script>