<div class="modal" tabindex="-1" id="add_base_modal">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Add Base</h5>
        <button type="button" class="btn" data-bs-dismiss="modal" aria-label="Close"><i class="bi bi-x"></i></button>
      </div>
      <div class="modal-body">
        <form name="add_base_form">
          <div data-form_group class="mb-3">
            <label for="base_name" class="form-label">Name (required)</label>
            <input data-mandatory="true" type="type" class="form-control" name="name" placeholder="Enter a name for you base...">
          </div>
          <div data-form_group class="mb-3">
            <label for="base_description" class="form-label">Description (optional)</label>
            <textarea class="form-control" name="description"></textarea>
          </div>
          <div>
            <label>Tier</label>
            <div class="card tier_card selected mb-2">
              <div class="card-body">
                Explorer (Free)
              </div>
            </div>
            <div class="card tier_card mb-2">
              <div class="card-body">
                Starter ($5 USD a Month)
              </div>
            </div>
            <div class="card tier_card mb-2">
              <div class="card-body">
                Professional ($25 USD a Month)
              </div>
            </div>
            <div class="card tier_card mb-2">
              <div class="card-body">
                Enterprise ($250 USD a Month + overages)
              </div>
            </div>
          </div>
        </form>
      </div>
      <div class="modal-footer d-flex align-items-center justify-content-between">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Close</button>
        <button data-action="add_base" type="button" class="btn btn-primary">Confirm</button>
      </div>
    </div>
  </div>
</div>
<script type="module">
  import FormUtil from "../scripts/utils/FormUtil.js";
  import BaseUtil from "../scripts/bases/BaseUtil.js";
  (() => {
    const form = new FormUtil({
      selector: "[name='add_base_form']"
    }).init();
    const addBaseBtn = document.querySelector("[data-action='add_base']");
    addBaseBtn.onclick = (evt) => {
      evt.preventDefault();
      if (!form.canSubmit()) {
        return;
      }
      new BaseUtil().createBase({
        name: form.getValue("[name='name']"),
        description: form.getValue("[name='description']")
      });

      if (Turbo) {
        Turbo.visit(`${document.location.pathname}${document.location.search}`);
      }
    }

    const add_base_modal = document.getElementById('add_base_modal');
    add_base_modal.addEventListener('hidden.bs.modal', function(event) {
      form.reset();
    })
  })()
</script>