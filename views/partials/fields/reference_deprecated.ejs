<div data-lookup_wrapper class="dropdown w-100">
 <div class="input-group">
  <input data-lookup="<%=typeof collection !== 'undefined' ? collection : field.reference_model%>" data-mandatory="<%=field.mandatory === "yes" ? 'true':'false'%>" class="form-control" type="text" value="<%=typeof record !== 'undefined' && record[field.name] ? record[field.name].display_value : ''%>"  placeholder="Search..." data-dropdown_btn/>
  <a target="_blank" class="btn btn-primary" href="/<%=locals.base._id%>/<%=field.type === "asset" ? 'assets':locals.path === 'models' ? 'models':'content'%>/<%=field.type === "asset" ? '':field.reference_model+'/'%><%=typeof record !== 'undefined' && record[field.name] ? record[field.name].value : ''%>"><i class="bi bi-eye"></i></a>
 </div>

  <ul class="dropdown-menu bg-dark p-0 w-100" aria-labelledby="dropdownMenuButton1">
    <li></li>
    <li class="mb-2 p-3">
      <ul data-lookup_results class="list-group bg-dark p-0" style="width:100%;max-height:200px;overflow-y: auto;">
      </ul>
    </li>
  </ul>
  <input  data-type="<%=field.type%>" name="<%=field.name%>" data-lookup_value value="<%=typeof record !== 'undefined' && record[field.name] ? record[field.name].value : ''%>" type="hidden" />
</div>