<%if(field.type === "single_line_text"){%>
<input data-type="<%=field.type%>" name="<%=field.name%>" data-mandatory="<%field.mandatory === "yes" ? 'true':'false'%>" class="form-control" type="text" value="<%=typeof record !== 'undefined' ? record[field.name] : ''%>" />
<%}%>

<%if(field.type === "number"){%>
<input data-type="<%=field.type%>" name="<%=field.name%>" data-mandatory="<%field.mandatory === "yes" ? 'true':'false'%>" class="form-control" type="number" value="<%=typeof record !== 'undefined' ? record[field.name] : ''%>" />
<%}%>

<%if(field.type === "checkbox"){%>
<input data-type="<%=field.type%>" name="<%=field.name%>" type="checkbox" value="<%=typeof record !== 'undefined' ? record[field.name] : ''%>" />
<%}%>

<%if(field.type === "multi_line_text"){%>
<textarea data-type="<%=field.type%>" name="<%=field.name%>" data-mandatory="<%field.mandatory === "yes" ? 'true':'false'%>" rows="5" class="form-control"><%=typeof record!=='undefined' ? record[field.name] : ''%></textarea>
<%}%>

<%if(field.type === "rich_text"){%>
<input data-type="<%=field.type%>" name="<%=field.name%>" data-mandatory="<%field.mandatory === "yes" ? 'true':'false'%>" class="form-control" type="text" value="<%=typeof record !== 'undefined' ? record[field.name] : ''%>" />
<%}%>

<%if(field.type === "reference"){%>
    <%-include(`../../partials/fields/reference.ejs`,{field:field})%>
<%}%>

<%if(field.type === "asset"){%>
<input data-type="<%=field.type%>" name="<%=field.name%>" data-mandatory="<%field.mandatory === "yes" ? 'true':'false'%>" class="form-control" type="text" value="<%=typeof record !== 'undefined' ? record[field.name] : ''%>" />
<%}%>

<%if(field.type === "choice"){%>
<select data-type="<%=field.type%>" name="<%=field.name%>" data-mandatory="<%field.mandatory === "yes" ? 'true':'false'%>" class="form-select">
    <option value="" selected>Yes</option>
    <option value="yes">Yes</option>
    <option value="no">No</option>
</select>
<%}%>

<%if(field.type === "yes_no"){%>
<select data-type="<%=field.type%>" name="<%=field.name%>" data-mandatory="<%field.mandatory === "yes" ? 'true':'false'%>" class="form-select">
  <option value="" selected>Yes</option>
  <option value="yes">Yes</option>
  <option value="no">No</option>
</select>
<%}%>