<%if(field.type === "single_line_text"){%>
<input data-type="<%=field.type%>" name="<%=field.name%>" data-mandatory="<%=field.mandatory === "yes" ? 'true':'false'%>" class="form-control" type="text" value="<%=typeof record !== 'undefined' ? record[field.name] : ''%>" />
<%}%>

<%if(field.type === "number"){%>
<input data-type="<%=field.type%>" name="<%=field.name%>" data-mandatory="<%=field.mandatory === "yes" ? 'true':'false'%>" class="form-control" type="number" value="<%=typeof record !== 'undefined' ? record[field.name] : ''%>" />
<%}%>

<%if(field.type === "checkbox"){%>
<input class="form-check" style="width:16px;height:16px;" data-type="<%=field.type%>" name="<%=field.name%>" type="checkbox" <%if(typeof record !== 'undefined' && String(record[field.name]) === "true"){%>checked<%}%> />
<%}%>

<%if(field.type === "multi_line_text"){%>
<textarea data-type="<%=field.type%>" name="<%=field.name%>" data-mandatory="<%=field.mandatory === "yes" ? 'true':'false'%>" rows="5" class="form-control"><%=typeof record!=='undefined' ? record[field.name] : ''%></textarea>
<%}%>

<%if(field.type === "rich_text"){%>
<textarea id="<%=field.name%>" class="wyswyg d-none" name="<%=field.name%>"><%=typeof record!=='undefined' ? record[field.name] : ''%></textarea>
<%}%>

<%if(field.type === "reference"){%>
<%-include(`../../partials/fields/reference.ejs`,{field:field})%>
<%}%>

<%if(field.type === "asset"){%>
<%-include(`../../partials/fields/reference.ejs`,{field:field,collection:"sys_asset"})%>
<%}%>

<%if(field.type === "choice"){%>
<select data-type="<%=field.type%>" name="<%=field.name%>" data-mandatory="<%=field.mandatory === "yes" ? 'true':'false'%>" class="form-select">
  <%if(typeof record === "undefined" || !record[field.name]){%>
  <option selected value="">-Select-</option>
  <%}%>
  <%if(typeof field.choices !== "undefined"){
    try{
        var choices = JSON.parse(field.choices);
    }catch(error){
        console.log(error);
    }
   }
   %>
  <%if(typeof choices !== "undefined"){%>
  <%choices.forEach((choice)=>{%>
  <option value="<%=choice.value%>" <%if(typeof record !== 'undefined' && (record[field.name] === choice.value)){%>selected<%}%>><%=choice.key%></option>
    <%})%>
    <%}%>
</select>
<%}%> <%if(field.type === "yes_no"){%> <select data-type="<%=field.type%>" name="<%=field.name%>" data-mandatory="<%=field.mandatory === "yes" ? 'true':'false'%>" class="form-select">
      <option value="yes" <%if(typeof record !== 'undefined' && record[field.name] === "yes"){%>selected<%}%>>Yes</option>
    <option value="no" <%if(typeof record !== 'undefined' && record[field.name] === "no"){%>selected<%}%>>No</option>
</select>
<%}%>