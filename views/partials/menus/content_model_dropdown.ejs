<div style="padding:0;width:300px;" class="dropdown_select_wrapper d-flex align-items-center">
  <div>
    <button data-action="expand_items" type="button" class="me-1 btn btn-secondary d-none">
      <i class="bi bi-arrows-expand-vertical"></i>
    </button>
  </div>
  <div class="dropdown w-100 ">
    <button class="btn btn-light border-secondary d-flex align-items-center justify-content-between w-100" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
      <div><%=typeof model !== "undefined" ? "Content: "+model.label : "Content: All"%></div>
      <div><i class="bi bi-chevron-down"></i><i class="bi bi-chevron-up d-none"></i></div>
    </button>
    <ul style="width:100%;max-height:200px;overflow-y: auto;" class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
      <li>
        <a class="d-block dropdown-item" href="/<%=locals.base._id%>/content/">All</a>
      </li>
      <%models.forEach((model)=>{%>
      <li>
        <a class="d-block dropdown-item" href="/<%=locals.base._id%>/content/<%=model._id%>"><%=model.label%></a>
      </li>
      <%})%>
    </ul>
  </div>
</div>