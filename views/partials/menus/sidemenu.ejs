<div class="sidemenu">
  <div class="sidemenu_header">
    <%-include('../../partials/logo.ejs')%>
  </div>
  <div class="sidemenu_body">
    <div class="sidemenu_dropdown_select_wrapper">
      <div class="dropdown w-100 ">
        <button class="btn btn-light border-secondary d-flex align-items-center justify-content-between w-100" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
          <div>Base:<strong class="ms-1"><%=locals.base.name%></strong></div>
          <div><i class="bi bi-chevron-down"></i></div>
        </button>
        <ul style="width:300px;" class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
          <li>
            <div class="dropdown-header">Bases</div>
          </li>
          <li>
            <hr class="dropdown-divider">
          </li>
          <%locals.bases && locals.bases.forEach((base)=>{%>
          <li><a class="dropdown-item" href="/<%=base._id%>/dashboard"><%=base.name%></a></li>
          <%})%>
        </ul>
      </div>
    </div>
    <div class="main_search_wrapper">
      <input class="form-control main_search_input" placeholder="Search...">
    </div>
    <div class="link_wrapper">
      <a href="/<%=locals.base._id%>/dashboard" class="link <%if(locals.path === '' || locals.path ==='dashboard'){%>active<%}%>">Dashboard</a>
    </div>
    <div class="link_wrapper">
      <a href="/<%=locals.base._id%>/content" class="link <%if(locals.path.indexOf('content') !== -1){%>active<%}%>">Content</a>
    </div>
    <div class="link_wrapper">
      <a href="/<%=locals.base._id%>/models" class="link <%if(locals.path.indexOf('models') !== -1){%>active<%}%>" >Models</a>
    </div>
    <div class="link_wrapper">
      <a href="/<%=locals.base._id%>/assets" class="link <%if(locals.path.indexOf('assets') !== -1){%>active<%}%>">Assets</a>
    </div>
    <div class="link_wrapper">
      <a href="/<%=locals.base._id%>/settings" class="link  <%if(locals.path.indexOf('settings') !== -1){%>active<%}%>">Settings</a>
    </div>
    <div class="link_wrapper">
        <div class="d-flex align-items-center" style="padding-left:10px;">
        <%-include('../../partials/profile_dropdown.ejs',{show_email:true,drop_class:"dropup"})%>
        </div>
    </div>

    <div class="d-none w-100 d-flex align-items-center" style="position:absolute;left:0;
    bottom:0;height:60px;background:rgba(255,255,255,.10);z-index: 2;padding:0 20px;">
        <div class="link_wrapper w-100">
           <div class="">
            <%-include('../../partials/profile_dropdown.ejs',{drop_class:"dropup"})%><span class="ms-2 text-white">Profile</span>
           </div>
          </div>
    </div>
  </div>
</div>