<div class="<%if(typeof drop_class === "undefined"){%>dropdown<%}else{%><%=drop_class%><%}%> d-inline-block profile_dropdown">
  <button  class="d-flex align-items-center btn text-dark text-white" data-bs-toggle="dropdown" aria-expanded="true"  title="Profile">
    <div style="height:40px;width:40px;" class="d-flex align-items-center justify-content-center rounded-circle border"><%=locals.user && locals.user.initial%></div>
    <%if(typeof show_email !== "undefined" && show_email){%>
    <span class="d-inline-block ms-2 text-white text-truncate" style="width:150px;"><%=locals.user.email%></span>
    <%}%>
  </button>
  <ul class="dropdown-menu w-100">
    <li>
      <a class="dropdown-item" href="/">Profile</a>
    </li>
    <li>
      <a class="dropdown-item" href="/logout">Logout</a>
    </li>
  </ul>
</div>