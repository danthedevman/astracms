<div data-table_parent_wrapper>
  <div data-table_search_wrapper class="d-flex align-items-center justify-content-between flex-wrap mb-2">
    <div>
      <input style="min-width:300px;" class="form-control" placeholder="Search keywords...">
    </div>
    <div>
      <button class="btn btn-secondary">
        <i class="bi bi-gear"></i>
      </button>
    </div>
  </div>
  <div style="overflow:auto;">
    <table class="table records_table table-responsive">
      <thead>
        <tr>
          <%if(!locals.stream){%>
          <th style="width:32px; vertical-align:middle;" scope="col">
            <input style="width:16px;" type="checkbox" class="form-check m-0" />
          </th>
          <%}%>
      <%if(locals.query && locals.query.record_select === 'single'){%>
          <th style="vertical-align:middle;" scope="col">
            <div class="field_title">
              Action
            </div>
          </th>
          <%}%>
      <%fields.forEach((field,i)=>{%>
          <th scope="col" data-sort_by="<%=field.name%>" data-sort_by_direction="<%=locals.sort_by_direction && locals.sort_by_direction  === "asc" ? "desc" : "asc" || 'asc'%>">
            <div class="field_title d-flex align-items-center justify-content-between"><%=field.label%>
              <div <%if((locals.sort_by_direction === "asc" && locals.sort_by === field.name)){%>class="d-block" <%}else{%>class="d-none" <%}%> role="button">
                <i class="text-white bi bi-caret-up-fill"></i>
              </div>
              <div <%if(locals.sort_by_direction === "desc" && locals.sort_by === field.name || !locals.sort_by && field.name === "_updated_on"){%>class="d-block" <%}else{%>class="d-none" <%}%> role="button">
                <i class="text-white bi bi-caret-down-fill"></i>
              </div>
            </div>
          </th>
          <%})%>
        </tr>
      </thead>
      <tbody>
        <%records.forEach((record)=>{%>
        <tr data-clickable_row data-table_row_record_id="<%=record._id%>" data-table_row_model_id="<%=record._model && record._model.value ? record._model.value : record._model && ! record._model.value ? record._model : ''%>">
          <%if(!locals.stream){%>
          <th scope="row" style="vertical-align: middle;">
            <input onclick="event.stopPropagation()" style="width:16px;" type="checkbox" class="form-check me-3 flex-shrink-0" />
          </th>
          <%}%>
      <%if(locals.query && locals.query.record_select === 'single'){%>
          <th style="vertical-align:middle;" scope="col">
            <button data-action="select_record" data-record_id="<%=record._id%>" data-record_title="<%=record._title%>" class="btn btn-primary">Select</button>
          </th>
          <%}%>
      <%fields.forEach((field)=>{%>
          <%if(field.type === "reference" || field.type === "asset"){%>
          <td scope="col">
            <div class="field_value"><%=record[field.name] ? record[field.name].display_value : ''%></div>
          </td>
          <%}else{%>
          <td scope="col">
            <div class="field_value"><%=record[field.name]%></div>
          </td>
          <%}%>
      <%})%>
        </tr>
        <%})%>
      </tbody>
    </table>
  </div>
  <div class="d-flex align-items-center mt-3">
    <ul class="pagination">
      <li class="page-item">
        <a class="page-link" href="#" aria-label="Previous">
          <span aria-hidden="true">&laquo;</span>
        </a>
      </li>
      <li class="page-item"><a class="page-link" href="#">1</a></li>
      <li class="page-item"><a class="page-link" href="#">2</a></li>
      <li class="page-item"><a class="page-link" href="#">3</a></li>
      <li class="page-item">
        <a class="page-link" href="#" aria-label="Next">
          <span aria-hidden="true">&raquo;</span>
        </a>
      </li>
    </ul>
  </div>
  <input type="hidden" name="reference_field" value="<%=locals.query && locals.query.reference_field ? locals.query.reference_field:''%>"/>
</div>
<script>
  (() => {
      const recordRows = document.querySelectorAll(`[data-table_row_record_id]`);
      recordRows.forEach((row) => {
        row.onclick = () => {
          <%if(locals.stream){%>
            return;
          <%}%>
          let model = row.getAttribute("data-table_row_model_id");
          let record = row.getAttribute("data-table_row_record_id");
          if (!model || !record) return;
          Turbo.visit(`/<%=locals.base._id%>/content/${model}/${record}`);
        };
      });

      const sortBtns = document.querySelectorAll("[data-sort_by]");
      sortBtns.forEach((btn) => {
            btn.onclick = async (evt) => {
                  evt.preventDefault();
                  <%if(!locals.stream){%>
                  Turbo.visit(`${location.toString().replace(location.search, "")}?sort_by=${btn.getAttribute("data-sort_by")}&sort_by_direction=${btn.getAttribute("data-sort_by_direction")}`)
                  <%}else{%>
                  let tableStream = await fetch(`/<%=locals.base._id%>/content/<%=locals.model._id%>?get_stream=true&record_select=single&field=123&target=content_table_reference&sort_by=${btn.getAttribute("data-sort_by")}&sort_by_direction=${btn.getAttribute("data-sort_by_direction")}`, {
                    method: "GET",
                    credentials: "same-origin",
                    headers: {
                      "Content-Type": "text/vnd.turbo-stream.html",
                    },
                  });

                  if (tableStream && tableStream.status === 200) {
                    const tableStreamTemplate = await tableStream.text();
                    Turbo.renderStreamMessage(tableStreamTemplate);
                  }
                <%}%>
      };
    });
    <%if(locals.stream){%>
    const selectReferenceBtn = document.querySelectorAll("[data-action='select_record']");
    selectReferenceBtn.forEach((btn) => {
            btn.onclick = async (evt) => {
                  evt.preventDefault();
                  evt.stopPropagation();
                  
                
                  let record_id = btn.getAttribute("data-record_id");
                  let record_title = btn.getAttribute("data-record_title");
                  let reference_field =  document.querySelector(`#field_<%=locals.query && locals.query.reference_field ? locals.query.reference_field:''%>`);
                  if(!reference_field){
                    return;
                  }
                  reference_field.value = record_id;
                  let template = `<a target="_blank" href="/<%=locals.base._id%>/content/<%=locals.model._id%>/${record_id}" class="d-flex align-items-center justify-content-between mt-2 reference_field_record rounded">
      <div class="text-white p-2">${record_title}</div>
      <div><i class="bi bi-chevron-right text-white"></i></div>
    </a>`;
                  reference_field.closest("[data-reference_field_wrapper]").querySelector("[data-selected_record_wrapper]").innerHTML = template;
                  const referenceMOdal = bootstrap.Modal.getInstance(document.getElementById("reference_modal"));

    console.log(referenceMOdal)
    referenceMOdal.hide();
           };
    });
    <%}%>



  })();
</script>