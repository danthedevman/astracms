<div data-upload_asset_wrapper>
  <button data-action="upload_asset" class="btn btn-primary border-secondary d-flex align-items-center justify-content-between" type="button">
    <div><i class="bi bi-plus me-2"></i>Add Asset</div>
  </button>
  <input type="file" class="d-none" />
</div>
<script>
  (() => {
    const uploadAssetBtn = document.querySelector('[data-action="upload_asset"]');
    uploadAssetBtn.onclick = (evt) => {
      evt.preventDefault();
      const fileInput = uploadAssetBtn.closest("[data-upload_asset_wrapper]").querySelector("input[type='file']");

      fileInput.click();

      fileInput.onchange = (evt) => {
        let file = fileInput.files[0];

        if (!file) {
          return
        }
        uploadAssetBtn.setAttribute("disabled",true);
        const formData = new FormData();
        formData.append("file", file);
        fetch(`/${window._astracms.base_id}/assets/upload`, {
          method: "POST",
          body: formData,
        }).then((res) => {
          if (res.status === 200) {
            window.location.reload()
          }
          uploadAssetBtn.removeAttribute("disabled");
        });
      };
    }
  })();
</script>