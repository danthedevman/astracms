<div class="dropdown">
  <button class="btn btn-primary border-secondary d-flex align-items-center justify-content-between btn-lg" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
    <div><i class="bi bi-plus me-2"></i>Add Record</div>
    <div><i class="bi bi-chevron-down ms-2"></i></div>
  </button>
  <ul style="width:300px;" class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
    <li>
      <div class="dropdown-header py-0">Content</div>
    </li>
    <li>
      <hr class="dropdown-divider">
    </li>
    <%if(typeof models !== "undefined"){%>
    <%models.forEach((model)=>{%>
    <li><a class="dropdown-item" href="/<%=locals.base._id%>/content/<%=model._id%>/new"><%=model.label%></a></li>
    <%})%>
    <%}%>
  </ul>
</div>