<div class="d-flex align-items-center">
  <button data-action="save_content_record" class="btn btn-primary border-secondary d-flex align-items-center justify-content-between me-2" type="button">
    <div><i class="bi bi-save me-2"></i>Save</div>
  </button>
  <button data-action="publish_content_record" class="btn btn-success d-flex align-items-center justify-content-between me-2" type="button">
    <div><i class="bi bi-send me-2"></i>Publish</div>
  </button>
  <div class="dropdown">
    <button class="btn btn-secondary" type="button" id="dropdownMenuButton1" data-bs-toggle="dropdown" aria-expanded="false">
      <i class="bi bi-three-dots-vertical"></i>
    </button>
    <ul class="dropdown-menu" aria-labelledby="dropdownMenuButton1">
      <li><a class="dropdown-item" data-action="unpublish_record" href="javascript:void(0);"><i class="bi bi-arrow-counterclockwise me-2"></i>Unpublish</a></li>
      <li><a class="dropdown-item text-danger" data-action="delete_record" href="javascript:void(0);"><i class="bi bi-trash me-2"></i>Delete</a></li>
    </ul>
  </div>
</div>


<script type="module">
  import FormUtil from "/scripts/utils/FormUtil.js";
  import ModelUtil from "/scripts/utils/ModelUtil.js";
  import ContentUtil from "/scripts/utils/ContentUtil.js";
  (() => {
    const formUtil = new FormUtil({
      selector: "[name='content_record_form']"
    }).init();

    const saveRecordBtn = document.querySelector(`[data-action="save_content_record"]`);
    saveRecordBtn.onclick = async (evt) => {
      evt.preventDefault();
      if (!formUtil.canSubmit()) {
        return;
      }

      const form_data = new FormData(formUtil.form);
      const wyswygFields = document.querySelectorAll(".wyswyg");
      wyswygFields.forEach((field)=>{
        form_data.set(field.getAttribute("name"),tinymce.get(`${field.getAttribute("name")}`).getContent());
      });

      const checkboxes = document.querySelectorAll("[type='checkbox']");
      checkboxes.forEach((field)=>{
        form_data.set(field.getAttribute("name"),field.checked);
      });

      let res = await new ContentUtil().saveRecord({
        form_data: form_data,
        model_id: "<%=model._id%>",
        record_id: "<%=typeof record !== 'undefined' ? record._id : null%>"
      });

      if (Turbo && res.status === 200) {
        let json = await res.json();
        Turbo.visit(`/<%=locals.base._id%>/content/<%=model._id%>/${json.record_id}`);
      }
    };

    const publishRecordBtn = document.querySelector(`[data-action="publish_content_record"]`);
    publishRecordBtn.onclick = async (evt) => {
      evt.preventDefault();
      if (!formUtil.canSubmit()) {
        return;
      }

      const form_data = new FormData(formUtil.form);
      let res = await new ContentUtil().publishRecord({
        form_data: form_data,
        model_id: "<%=model._id%>",
        record_id: "<%=typeof record !== 'undefined' ? record._id : null%>"
      });

      if (Turbo && res.status === 200) {
        let json = await res.json();
        Turbo.visit(`/<%=locals.base._id%>/content/<%=model._id%>/${json.record_id}`);
      }
    };

    const unpublishRecordBtn = document.querySelector(`[data-action="unpublish_record"]`);
    unpublishRecordBtn.onclick = async (evt) => {
      evt.preventDefault();
      if (!formUtil.canSubmit()) {
        return;
      }

      const form_data = new FormData(formUtil.form);
      let res = await new ContentUtil().unpublishRecord({
        form_data: form_data,
        model_id: "<%=model._id%>",
        record_id: "<%=typeof record !== 'undefined' ? record._id : null%>"
      });

      if (Turbo && res.status === 200) {
        let json = await res.json();
        Turbo.visit(`/<%=locals.base._id%>/content/<%=model._id%>/${json.record_id}`);
      }
    };

    const deleteRecordBtn = document.querySelector(`[data-action="delete_record"]`);
    deleteRecordBtn.onclick = async (evt) => {
      evt.preventDefault();
      const confirmDelete = confirm("Are you sure you want to delete this record?");
      if(!confirmDelete) return;

      let res = await new ContentUtil().deleteRecord({
        model_id: "<%=model._id%>",
        record_id: "<%=typeof record !== 'undefined' ? record._id : null%>"
      });

      if (Turbo && res.status === 200) {
        Turbo.visit(`/<%=locals.base._id%>/content/<%=model._id%>`);
      }
    };

  })();
</script>